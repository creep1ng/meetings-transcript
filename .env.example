# =============================================================================
# Environment Configuration for Meetings Transcript
# Copy this file to .env and fill in the required values
# =============================================================================

# -----------------------------------------------------------------------------
# Source Configuration
# -----------------------------------------------------------------------------
# Source type: 'local' (default) or 's3'
# Can be overridden with --source CLI flag
# SOURCE=local     

# -----------------------------------------------------------------------------
# AWS Credentials (required for S3 source)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# S3 Configuration (required for S3 source)
# -----------------------------------------------------------------------------
# S3_BUCKET_NAME=your-bucket-name
VIDEO_PREFIX=videos/
TRANSCRIPTS_PREFIX=transcripts/

# -----------------------------------------------------------------------------
# Transcription Settings
# -----------------------------------------------------------------------------

# MODEL_SIZE can be any of the following: tiny, base, small, medium, large, turbo
MODEL_SIZE=small                     

# DEVICE can be cpu or cuda (cuda requires GPU)
DEVICE=cpu                           

# 0 to disable, >0 to enable chunking
# TRANSCRIPT_CHUNK_SECONDS=0         

# 10MB chunks for streaming downloads
# DOWNLOAD_CHUNK_BYTES=10485760      

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
# MAX_CONCURRENT_JOBS=1

# -----------------------------------------------------------------------------
# Timeouts and Retries
# -----------------------------------------------------------------------------
# Seconds for S3 operations
# S3_TIMEOUT=300                     

# Seconds for transcription jobs
# TRANSCRIPTION_TIMEOUT=3600         

# MAX_RETRIES=3
# RETRY_BACKOFF_BASE=2.0

# -----------------------------------------------------------------------------
# Validation Limits
# -----------------------------------------------------------------------------
# 2GB maximum file size
# MAX_FILE_SIZE_BYTES=2147483648     

# -----------------------------------------------------------------------------
# Logging and Tracing
# -----------------------------------------------------------------------------
# LOG_LEVEL can be any of DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO                     

# true/false for OpenTelemetry hooks
# ENABLE_TRACING=false               

# Destination (optional). When omitted, local sources publish locally and S3
# sources publish to S3 for backwards compatibility.
# DESTINATION=webdav

# Nextcloud WebDAV (required only when DESTINATION=webdav)
# Use the user files endpoint and an app password, never the account password.
# WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/username
# WEBDAV_USERNAME=username
# WEBDAV_PASSWORD=nextcloud-app-password
# WEBDAV_ROOT_PATH=/Notes/MyVault
# WEBDAV_MEDIA_SUBFOLDER=Media
# WEBDAV_TIMEOUT=30

# -----------------------------------------------------------------------------
# Local-first academic organizer (`python main.py study`)
# -----------------------------------------------------------------------------
# Required local folder synchronized by the Nextcloud desktop client.
# Keep paths with spaces unquoted; the env-file parser treats quotes literally.
# ACADEMIC_LIBRARY_ROOT=/home/username/Nextcloud/Academic

# Source browsing is confined to this root and starts in ACADEMIC_START_PATH.
# ACADEMIC_SOURCE_ROOT=/home/username
# ACADEMIC_START_PATH=/home/username/Downloads

# ACADEMIC_LANGUAGE=es               # es, en, or auto
# ACADEMIC_MODEL=large-v3
# ACADEMIC_DEVICE=auto               # auto, cpu, or cuda
# ACADEMIC_COMPUTE_TYPE=auto         # auto => CUDA float16 / CPU int8
# ACADEMIC_STATE_ROOT=/home/username/.local/state/meetings-transcript/academic
# ACADEMIC_MODEL_CACHE=/home/username/.cache/whisperx
# ACADEMIC_SHOW_HIDDEN=false
# ACADEMIC_INCLUDE_INCOMPLETE=false

# Provision once after accepting the pyannote model license, then remove the
# token and switch back to offline-only inference.
# ACADEMIC_LOCAL_FILES_ONLY=true
# HF_TOKEN=hf_initial-provisioning-token
